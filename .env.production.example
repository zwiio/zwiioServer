NODE_ENV=production
APP_PORT=3008
APP_NAME="NestJS Phone Auth API"
API_PREFIX=api
APP_FALLBACK_LANGUAGE=en
APP_HEADER_LANGUAGE=x-custom-lang
FRONTEND_DOMAIN=https://app.example.com
BACKEND_DOMAIN=https://api.example.com

DATABASE_TYPE=mongodb
DATABASE_NAME=phone_auth_api
DATABASE_URL=mongodb+srv://user:password@cluster.example.mongodb.net/?retryWrites=true&w=majority

# Twilio Verify production credentials and service.
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=replace-with-your-production-twilio-auth-token
TWILIO_VERIFY_SERVICE_SID=VAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Prefer S3-compatible storage in production.
FILE_DRIVER=s3
ACCESS_KEY_ID=replace-with-access-key-id
SECRET_ACCESS_KEY=replace-with-secret-access-key
AWS_S3_REGION=replace-with-region
AWS_DEFAULT_S3_BUCKET=replace-with-bucket-name

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=replace-with-smtp-user
MAIL_PASSWORD=replace-with-smtp-password
MAIL_IGNORE_TLS=false
MAIL_SECURE=false
MAIL_REQUIRE_TLS=true
MAIL_DEFAULT_EMAIL=noreply@example.com
MAIL_DEFAULT_NAME=Api
MAIL_CLIENT_PORT=1080

AUTH_JWT_SECRET=replace-with-a-production-jwt-secret
AUTH_JWT_TOKEN_EXPIRES_IN=15m
AUTH_REFRESH_SECRET=replace-with-a-production-refresh-secret
AUTH_REFRESH_TOKEN_EXPIRES_IN=30d
AUTH_FORGOT_SECRET=replace-with-a-production-forgot-secret
AUTH_FORGOT_TOKEN_EXPIRES_IN=30m
AUTH_CONFIRM_EMAIL_SECRET=replace-with-a-production-confirm-email-secret
AUTH_CONFIRM_EMAIL_TOKEN_EXPIRES_IN=1d

WORKER_HOST=redis://redis.example.com:6379/1
